---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import PaintingCredit from "../../components/PaintingCredit.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { getPainting } from "../../lib/paintings";
import { sessionLabels, siteConfig } from "../../site-config";

const painting = getPainting("ink-bamboo");
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  heroImage={painting.image}
  heroImageAlt={painting.alt}
  {...siteConfig}
>
  <PaintingCredit painting={painting} cropped />
  <p>
    The internal collection and URL stay <code>sessions</code>. Set the visible
    singular and plural names once in <code>src/site-config.ts</code> and use
    the language your course deserves everywhere readers see it.
  </p>
  <SessionsGrid />
</ContentLayout>
